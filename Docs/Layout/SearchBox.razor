@implements IDisposable
@inject SearchIndexService SearchIndexService
@inject DocsUiState UiState
@inject NavigationManager NavigationManager

<div class="search-box @(this.IsInteractive ? "" : "search-box-loading")" @onfocusout="this.OnFocusOut">
    <input type="search" class="search-box-input" placeholder="Search docs" aria-label="Search the documentation"
           autocomplete="off" value="@this._text" disabled="@(!this.IsInteractive)"
           @onfocus="this.OnFocus" @oninput="this.OnInputAsync" @onkeydown="this.OnKeyDownAsync" />

    @if (!this.IsInteractive)
    {
        <span class="search-box-spinner" aria-hidden="true"></span>
    }

    @if (this._isOpen)
    {
        <div class="search-box-results">
            @if (this.Status is { Length: > 0 } status)
            {
                <p class="search-box-status" aria-live="polite">@status</p>
            }
            else
            {
                <ul>
                    @foreach (var result in this._results)
                    {
                        <li>
                            @* Keeping the mouse down from moving the focus is what lets the click below land before the list closes. *@
                            <a href="@result.Url" @onmousedown:preventDefault
                               @onclick="() => this.Select(result)" @onclick:preventDefault>
                                <span class="search-box-result-title">@result.Title</span>
                                @if (result.Heading != result.Title)
                                {
                                    <span class="search-box-result-heading">@result.Heading</span>
                                }
                                <span class="search-box-result-text">@result.Text</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code
{
    private const int MaxResults = 10;

    /// <summary>How long to wait after the last keystroke before running a search.</summary>
    private static readonly TimeSpan DebounceDelay = TimeSpan.FromMilliseconds(400);

    /// <summary>How long to leave the loading of the page itself alone before the warm-up starts.</summary>
    private static readonly TimeSpan WarmUpDelay = TimeSpan.FromSeconds(1);

    private string _text = "";

    private bool _isOpen;

    /// <summary>
    /// The version whose index is loaded and ready to search. Every version has its own index, so
    /// this has to be the version itself rather than a flag: switching to another one puts the box
    /// back into its loading state until that version's index arrives too.
    /// </summary>
    private string _readyVersion = "";

    /// <summary>The version the warm-up under way, or the last one, is for.</summary>
    private string _warmUpVersion = "";

    /// <summary>
    /// Cancelling this does not abandon the warm-up, it only cuts short the wait it starts with.
    /// </summary>
    private CancellationTokenSource? _warmUpWait;

    private bool _isSearching;

    private SearchResult[] _results = [];

    private CancellationTokenSource? _debounceCancellation;

    /// <summary>The text of the search box that <see cref="_results"/> was built from.</summary>
    private string _appliedText = "";

    /// <summary>The version the current results belong to, so that switching versions can drop them.</summary>
    private string _resultsVersion = "";

    /// <summary>
    /// Whether the WebAssembly runtime is there to answer this box. The prerendered HTML puts it on
    /// the page well before that, and a box that cannot search yet must not invite the visitor in.
    /// </summary>
    private bool IsInteractive => OperatingSystem.IsBrowser();

    /// <summary>Whether the index of the version being read is loaded and ready to search.</summary>
    private bool IsReady => this._readyVersion == this.UiState.Version;

    /// <summary>What to tell the visitor instead of a result list, or an empty string when the results are worth showing.</summary>
    private string Status => (this.IsReady, this._isSearching, this._text.Trim(), this._results.Length) switch
    {
        (false, _, _, _) => "Loading the search index…",
        (_, true, _, _) => "Searching…",
        (_, _, "", _) => "Type to search the documentation of this version.",
        // Text the debounce still owes a search has no results yet rather than none to find.
        (_, _, var text, 0) when text != this._appliedText => "Searching…",
        (_, _, _, 0) => "No results.",
        _ => "",
    };

    protected override void OnInitialized() => this.UiState.Changed += this.OnUiStateChanged;

    /// <summary>
    /// Every render is a chance to notice that the version being read has no warm-up yet, which is
    /// how the first page load and every version switch alike reach one. Static prerendering never
    /// gets here, and must not, since the warm-up needs a browser to run the model in.
    /// </summary>
    protected override void OnAfterRender(bool firstRender) => this.ScheduleWarmUp();

    /// <summary>
    /// Starts loading the model and the index of the current version in the background, so that the
    /// visitor rarely has to wait for them at all. The wait it starts with keeps that 23 MB
    /// download away from the loading of the page itself. Doing this again for the same version, or
    /// before one is known, leaves the warm-up already under way alone.
    /// </summary>
    private void ScheduleWarmUp()
    {
        var version = this.UiState.Version;
        if (version.Length == 0 || version == this._warmUpVersion) return;

        this._warmUpVersion = version;
        this._warmUpWait?.Dispose();
        this._warmUpWait = new CancellationTokenSource();
        _ = this.WarmUpAsync(version, this._warmUpWait.Token);
    }

    private async Task WarmUpAsync(string version, CancellationToken hurryUp)
    {
        // Being cancelled here means "start now" rather than "give up", which is what focusing the
        // search box asks for.
        try { await Task.Delay(WarmUpDelay, hurryUp); } catch (OperationCanceledException) { }

        await this.SearchIndexService.WarmUpAsync(version);

        // A version switch has a warm-up of its own under way by now, so this one keeps quiet
        // rather than reporting an index nobody is going to search as the one that is ready.
        if (this._warmUpVersion != version) return;

        this._readyVersion = version;

        // Text typed while this was still loading, or left over from the version the visitor came
        // from, deserves an answer now that this index can give one.
        await this.SearchAsync();

        await this.InvokeAsync(this.StateHasChanged);
    }

    private void OnFocus()
    {
        this._isOpen = true;

        // The visitor is about to search, so the warm-up that the render scheduled has no reason to
        // keep waiting. What becomes of the text already in the box is left to the warm-up itself.
        this._warmUpWait?.Cancel();
    }

    private void OnFocusOut(FocusEventArgs args) => this._isOpen = false;

    private async Task OnInputAsync(ChangeEventArgs args)
    {
        this._text = args.Value as string ?? "";
        this._isOpen = true;

        // Drop the search that the previous keystroke scheduled, if it has not run yet.
        this._debounceCancellation?.Cancel();
        this._debounceCancellation = new CancellationTokenSource();
        var cancellationToken = this._debounceCancellation.Token;

        try { await Task.Delay(DebounceDelay, cancellationToken); }
        catch (OperationCanceledException) { return; }

        await this.SearchAsync();
    }

    /// <summary>
    /// Searches for whatever is in the box, unless the index it would need is not loaded yet, in
    /// which case the warm-up searches this text itself once it has one.
    /// </summary>
    private async Task SearchAsync()
    {
        if (!this.IsReady) return;

        var text = this._text.Trim();
        if (this._appliedText == text) return;
        this._appliedText = text;

        if (text.Length == 0)
        {
            this._results = [];
            this._isSearching = false;
            return;
        }

        this._isSearching = true;
        this.StateHasChanged();

        var version = this.UiState.Version;
        var results = await this.SearchIndexService.SearchAsync(version, text, MaxResults);

        // A newer search text may have been applied while this search was running.
        if (this._appliedText != text) return;

        this._results = results;
        this._resultsVersion = version;
        this._isSearching = false;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") { this._isOpen = false; return; }
        if (args.Key != "Enter") return;

        this._debounceCancellation?.Cancel();
        await this.SearchAsync();
    }

    private void Select(SearchResult result)
    {
        this._isOpen = false;
        this._text = "";
        this._appliedText = "";
        this._results = [];
        this.NavigationManager.NavigateTo(result.Url);
    }

    /// <summary>
    /// The results belong to one documentation version, so they are dropped when the visitor
    /// switches to another one. Clearing the applied text along with them is what lets the same
    /// search text run again against the index of the new version. Anything else the layout
    /// reports, such as the sidebar opening, leaves what the visitor typed alone.
    /// </summary>
    private void OnUiStateChanged()
    {
        if (this._resultsVersion != this.UiState.Version)
        {
            this._results = [];
            this._appliedText = "";
        }
        this.InvokeAsync(this.StateHasChanged);
    }

    public void Dispose()
    {
        this.UiState.Changed -= this.OnUiStateChanged;
        this._debounceCancellation?.Cancel();
        this._debounceCancellation?.Dispose();
        this._warmUpWait?.Dispose();
    }
}
