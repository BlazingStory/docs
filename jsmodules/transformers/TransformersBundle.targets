<Project>

  <!--
    Builds the browser bundle of "@xenova/transformers" out of the npm project next to this file.
    The importing project says where the two files it produces go, and those paths, relative to
    that project, are also what tells the target whether there is anything left to do:

      TransformersBundleJs   the ES module the browser loads, a Static Web Asset of the app
      TransformersBundleDts  its declarations, which "tsc" needs to compile the app's TypeScript

    See "What the build generates" in AGENTS.md for the "Restore" hook and the rest.
  -->

  <PropertyGroup>
    <TransformersBundleDir>$(MSBuildThisFileDirectory)</TransformersBundleDir>
  </PropertyGroup>

  <ItemGroup>
    <TransformersBundleInput Include="$(TransformersBundleDir)src\**" />
    <TransformersBundleInput Include="$(TransformersBundleDir)package.json" />
    <TransformersBundleInput Include="$(TransformersBundleDir)package-lock.json" />
    <TransformersBundleInput Include="$(TransformersBundleDir)tsconfig.json" />
  </ItemGroup>

  <Target Name="BuildTransformersBundle" BeforeTargets="Restore;Build"
          Inputs="@(TransformersBundleInput)" Outputs="$(TransformersBundleJs);$(TransformersBundleDts)">

    <Exec Command="npm ci" WorkingDirectory="$(TransformersBundleDir)"
          Condition="!Exists('$(TransformersBundleDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(TransformersBundleDir)" />

    <Copy SourceFiles="$(TransformersBundleDir)dist\transformers.min.js" DestinationFiles="$(TransformersBundleJs)" />
    <Copy SourceFiles="$(TransformersBundleDir)dist\transformers.min.d.ts" DestinationFiles="$(TransformersBundleDts)" />
  </Target>

</Project>
