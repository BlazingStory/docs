<Project>

  <!--
    Builds a custom PrismJS bundle out of the npm project next to this file, which is what replaced
    clicking the language list together on https://prismjs.com/download.html by hand. "build.mjs"
    holds that list. The importing project says where the bundle goes, and that path, relative to
    that project, is also what tells the target whether there is anything left to do:

      PrismBundleJs   the ES module the browser loads, a Static Web Asset of the app

    See "What the build generates" in AGENTS.md for the "Restore" hook and the rest.
  -->

  <PropertyGroup>
    <PrismBundleDir>$(MSBuildThisFileDirectory)</PrismBundleDir>
  </PropertyGroup>

  <ItemGroup>
    <PrismBundleInput Include="$(PrismBundleDir)build.mjs" />
    <PrismBundleInput Include="$(PrismBundleDir)package.json" />
    <PrismBundleInput Include="$(PrismBundleDir)package-lock.json" />
  </ItemGroup>

  <Target Name="BuildPrismBundle" BeforeTargets="Restore;Build"
          Inputs="@(PrismBundleInput)" Outputs="$(PrismBundleJs)">

    <Exec Command="npm ci" WorkingDirectory="$(PrismBundleDir)"
          Condition="!Exists('$(PrismBundleDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(PrismBundleDir)" />

    <Copy SourceFiles="$(PrismBundleDir)dist\prism.js" DestinationFiles="$(PrismBundleJs)" />
  </Target>

</Project>
